# ── Service selection ─────────────────────────────────────────────────────────
# VITE_USE_MOCK=true  → services read src/mock-data. Use this for design work.
# VITE_USE_MOCK=false → services call VITE_API_BASE_URL and validate with Zod.
VITE_USE_MOCK=true

# ── Mock transport behaviour ──────────────────────────────────────────────────
# VITE_MOCK_ERRORS=true   → a share of mock calls reject (200–800ms latency first)
VITE_MOCK_ERRORS=false
# VITE_MOCK_ERROR_RATE    → that share, 0–1. Defaults to 0.03 (3%).
#                            Set to 1 to force every data call to fail.
VITE_MOCK_ERROR_RATE=0.03

# ── Demo-only browser flags (localStorage, not build variables) ───────────────
# These are set in the browser console, not here. They exist so the demo can be
# driven faster than a real sitting:
#   vyuh.mock.monitorIntervalSeconds  faculty monitor feed tick (default 5)
#   vyuh.mock.hostTickSeconds         host console presence tick (default 6)
#   vyuh.mock.faults.<examId>         fault register mirrored by the faculty
#                                     service so student result sheets apply the
#                                     same policy; cleared with storage
#   vyuh.mock.faculty.<facultyId>.v1  the faculty seat's authored state

# ── Live API ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
